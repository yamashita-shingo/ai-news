---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
const articles = (await getCollection('articles')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const base = import.meta.env.BASE_URL;
const date = (d: Date) => new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'UTC' }).format(d);
---
<Layout>
  <main>
    <section class="overflow-hidden bg-[#17221d] text-white"><div class="relative mx-auto max-w-7xl px-6 pb-20 pt-20 md:px-10 md:pb-28 md:pt-28"><div class="absolute -right-24 -top-32 h-96 w-96 rounded-full border border-[#52674f] opacity-50"></div><div class="absolute -right-10 top-0 h-72 w-72 rounded-full border border-[#52674f] opacity-50"></div><p class="relative mb-8 inline-flex items-center gap-2 text-xs font-bold tracking-[.18em] text-[#c4fa4c]"><span class="h-2 w-2 rounded-full bg-[#c4fa4c]"></span> YOUR AI NEWS BRIEFING</p><h1 class="relative max-w-3xl text-4xl font-bold leading-[1.35] tracking-tight md:text-6xl">AIの今を、<br /><span class="text-[#c4fa4c]">いろんな視点</span>で。</h1><p class="relative mt-7 max-w-xl text-sm leading-8 text-[#b6c5b9] md:text-base">進化し続けるAIのニュースを、わかりやすく。<br />ひとつの出来事に、3つの視点を添えて届けます。</p><a href="#latest" class="relative mt-10 inline-flex items-center gap-8 rounded-full bg-[#c4fa4c] px-6 py-4 text-xs font-bold text-[#17221d] transition hover:bg-white">ニュースを読む <span>↘</span></a></div></section>
    <section id="latest" class="mx-auto max-w-7xl px-6 pt-20 md:px-10 md:pt-24"><div class="flex items-end justify-between border-b border-[#cfd8cb] pb-6"><div><p class="mb-3 text-xs font-bold tracking-[.18em] text-[#668056]">THE LATEST</p><h2 class="text-3xl font-bold tracking-tight md:text-4xl">新着ニュース<span class="text-[#9ecf36]">.</span></h2></div><span class="text-xs font-medium text-[#849086]">{String(articles.length).padStart(2, '0')} ARTICLES</span></div>
      {articles.length === 0 ? <div class="py-24 text-center"><p class="text-3xl text-[#9ecf36]">✳</p><p class="mt-5 font-bold">ニュースを準備しています。</p><p class="mt-3 text-sm text-[#758377]">最初の記事をお楽しみに。</p></div> : <div class="grid gap-x-7 gap-y-12 pt-9 sm:grid-cols-2 lg:grid-cols-3">{articles.map(article => <article class="group"><a href={`${base}articles/${article.id}/`} class="block"><div class="aspect-[4/3] overflow-hidden rounded-xl bg-[#e4eadf]"><img src={`${base}${article.data.image.slice(1)}`} alt={article.data.imageAlt} loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" /></div><div class="mt-5 flex items-center gap-3 text-xs font-bold"><span class="rounded-full bg-[#e5efcf] px-3 py-1.5 text-[#4d6e27]">{article.data.category}</span><time class="text-[#89958b]" datetime={article.data.date.toISOString()}>{date(article.data.date)}</time></div><h3 class="mt-4 text-lg font-bold leading-relaxed group-hover:text-[#688f23]">{article.data.title} <span class="text-[#91b850]">↗</span></h3><p class="mt-2 line-clamp-2 text-sm leading-7 text-[#78877c]">{article.data.description}</p></a></article>)}</div>}
    </section>
  </main>
</Layout>
